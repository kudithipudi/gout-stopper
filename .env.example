OPENROUTER_API_KEY=
ROOT_PATH=/gout-stopper
DB_PATH=data/gout-stopper.db
UPLOADS_DIR=data/uploads
ADMIN_PASSWORD=
SESSION_SECRET=
FOOD_DETECT_MODEL=openai/gpt-4o-mini
FOOD_IDENTIFY_MODEL=openai/gpt-4o-mini
ADVICE_MODEL=openai/gpt-4o-mini
GOUT_CLASSIFY_MODEL=openai/gpt-4o-mini
